{
  "components": {
    "schemas": {
      "ContaSaida": {
        "properties": {
          "conta_beneficio": {
            "title": "Conta Beneficio",
            "type": "boolean"
          },
          "conta_id": {
            "title": "Conta Id",
            "type": "integer"
          },
          "nome": {
            "title": "Nome",
            "type": "string"
          }
        },
        "required": [
          "conta_id",
          "nome",
          "conta_beneficio"
        ],
        "title": "ContaSaida",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginEntrada": {
        "properties": {
          "login": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Login",
            "type": "string"
          },
          "senha": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Senha",
            "type": "string"
          }
        },
        "required": [
          "login",
          "senha"
        ],
        "title": "LoginEntrada",
        "type": "object"
      },
      "LoginSaida": {
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          }
        },
        "required": [
          "csrf_token"
        ],
        "title": "LoginSaida",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "abako",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/eu": {
      "get": {
        "description": "Reentrega o token CSRF à página recarregada, sem expor o `user_id`.",
        "operationId": "auth_eu",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginSaida"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Eu",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "auth_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginEntrada"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginSaida"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "auth_logout",
        "parameters": [
          {
            "in": "header",
            "name": "x-csrf-token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Csrf-Token"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/contas": {
      "get": {
        "operationId": "contas_listar",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ContaSaida"
                  },
                  "title": "Response Contas Listar",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Listar",
        "tags": [
          "contas"
        ]
      }
    },
    "/api/contas/{conta_id}": {
      "get": {
        "operationId": "contas_obter",
        "parameters": [
          {
            "in": "path",
            "name": "conta_id",
            "required": true,
            "schema": {
              "title": "Conta Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContaSaida"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Obter",
        "tags": [
          "contas"
        ]
      }
    }
  }
}
