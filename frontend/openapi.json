{
  "components": {
    "schemas": {
      "ContaEntrada": {
        "properties": {
          "conta_beneficio": {
            "default": false,
            "title": "Conta Beneficio",
            "type": "boolean"
          },
          "nome": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Nome",
            "type": "string"
          }
        },
        "required": [
          "nome"
        ],
        "title": "ContaEntrada",
        "type": "object"
      },
      "ContaSaida": {
        "properties": {
          "conta_beneficio": {
            "title": "Conta Beneficio",
            "type": "boolean"
          },
          "conta_id": {
            "title": "Conta Id",
            "type": "integer"
          },
          "nome": {
            "title": "Nome",
            "type": "string"
          }
        },
        "required": [
          "conta_id",
          "nome",
          "conta_beneficio"
        ],
        "title": "ContaSaida",
        "type": "object"
      },
      "DivergenciaSaida": {
        "properties": {
          "conta_id": {
            "title": "Conta Id",
            "type": "integer"
          },
          "conta_nome": {
            "title": "Conta Nome",
            "type": "string"
          },
          "data_snapshot": {
            "format": "date",
            "title": "Data Snapshot",
            "type": "string"
          },
          "divergencia": {
            "title": "Divergencia",
            "type": "string"
          },
          "saldo_derivado": {
            "title": "Saldo Derivado",
            "type": "string"
          },
          "valor_snapshot": {
            "title": "Valor Snapshot",
            "type": "string"
          }
        },
        "required": [
          "conta_id",
          "conta_nome",
          "data_snapshot",
          "valor_snapshot",
          "saldo_derivado",
          "divergencia"
        ],
        "title": "DivergenciaSaida",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginEntrada": {
        "properties": {
          "login": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Login",
            "type": "string"
          },
          "senha": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Senha",
            "type": "string"
          }
        },
        "required": [
          "login",
          "senha"
        ],
        "title": "LoginEntrada",
        "type": "object"
      },
      "LoginSaida": {
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          }
        },
        "required": [
          "csrf_token"
        ],
        "title": "LoginSaida",
        "type": "object"
      },
      "SaldoSaida": {
        "properties": {
          "conta_beneficio": {
            "title": "Conta Beneficio",
            "type": "boolean"
          },
          "conta_id": {
            "title": "Conta Id",
            "type": "integer"
          },
          "nome": {
            "title": "Nome",
            "type": "string"
          },
          "saldo": {
            "title": "Saldo",
            "type": "string"
          },
          "snapshot_data": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Data"
          },
          "snapshot_valor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Valor"
          }
        },
        "required": [
          "conta_id",
          "nome",
          "conta_beneficio",
          "saldo",
          "snapshot_data",
          "snapshot_valor"
        ],
        "title": "SaldoSaida",
        "type": "object"
      },
      "SnapshotEntrada": {
        "properties": {
          "data": {
            "format": "date",
            "title": "Data",
            "type": "string"
          },
          "valor": {
            "pattern": "^-?[0-9]{1,12}(\\.[0-9]{1,2})?$",
            "title": "Valor",
            "type": "string"
          }
        },
        "required": [
          "data",
          "valor"
        ],
        "title": "SnapshotEntrada",
        "type": "object"
      },
      "SnapshotSaida": {
        "properties": {
          "conta_id": {
            "title": "Conta Id",
            "type": "integer"
          },
          "data": {
            "format": "date",
            "title": "Data",
            "type": "string"
          },
          "divergencia": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Divergencia"
          },
          "saldo_derivado": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Saldo Derivado"
          },
          "saldo_inicial": {
            "title": "Saldo Inicial",
            "type": "boolean"
          },
          "snapshot_id": {
            "title": "Snapshot Id",
            "type": "integer"
          },
          "valor": {
            "title": "Valor",
            "type": "string"
          }
        },
        "required": [
          "snapshot_id",
          "conta_id",
          "data",
          "valor",
          "saldo_inicial",
          "saldo_derivado",
          "divergencia"
        ],
        "title": "SnapshotSaida",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "abako",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/eu": {
      "get": {
        "description": "Reentrega o token CSRF à página recarregada, sem expor o `user_id`.",
        "operationId": "auth_eu",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginSaida"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Eu",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "auth_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginEntrada"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginSaida"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "auth_logout",
        "parameters": [
          {
            "in": "header",
            "name": "x-csrf-token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Csrf-Token"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/contas": {
      "get": {
        "operationId": "contas_listar",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ContaSaida"
                  },
                  "title": "Response Contas Listar",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Listar",
        "tags": [
          "contas"
        ]
      },
      "post": {
        "operationId": "contas_criar",
        "parameters": [
          {
            "in": "header",
            "name": "x-csrf-token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Csrf-Token"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContaEntrada"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContaSaida"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Criar",
        "tags": [
          "contas"
        ]
      }
    },
    "/api/contas/{conta_id}": {
      "get": {
        "operationId": "contas_obter",
        "parameters": [
          {
            "in": "path",
            "name": "conta_id",
            "required": true,
            "schema": {
              "maximum": 9223372036854775807,
              "minimum": 1,
              "title": "Conta Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContaSaida"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Obter",
        "tags": [
          "contas"
        ]
      }
    },
    "/api/contas/{conta_id}/snapshots": {
      "post": {
        "description": "Informa o saldo que o app do banco mostra. A divergência (R4) volta na resposta.",
        "operationId": "saldos_registrar_snapshot",
        "parameters": [
          {
            "in": "path",
            "name": "conta_id",
            "required": true,
            "schema": {
              "maximum": 9223372036854775807,
              "minimum": 1,
              "title": "Conta Id",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "x-csrf-token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Csrf-Token"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SnapshotEntrada"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotSaida"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Registrar Snapshot",
        "tags": [
          "saldos"
        ]
      }
    },
    "/api/r4": {
      "get": {
        "description": "Contas em que o saldo derivado difere do snapshot. Só sinaliza; nunca corrige.",
        "operationId": "saldos_r4",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DivergenciaSaida"
                  },
                  "title": "Response Saldos R4",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "R4",
        "tags": [
          "saldos"
        ]
      }
    },
    "/api/saldos": {
      "get": {
        "description": "Saldo derivado de cada conta em `em` (padrão: hoje). Não aceita data futura.",
        "operationId": "saldos_listar",
        "parameters": [
          {
            "in": "query",
            "name": "em",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Em"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SaldoSaida"
                  },
                  "title": "Response Saldos Listar",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Listar",
        "tags": [
          "saldos"
        ]
      }
    }
  }
}
