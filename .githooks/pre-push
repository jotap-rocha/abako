#!/usr/bin/env bash
# pre-push — aviso se destino é tronco (NÃO bloqueante neste MVP).
set -euo pipefail

remote="${1:-}"
url="${2:-}"
# stdin: <local_ref> <local_sha> <remote_ref> <remote_sha>

TRUNK_HINTS='^(refs/heads/(master|main)$)'

warn=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${remote_ref:-}" ]] && continue
  if printf '%s\n' "$remote_ref" | grep -Eq "$TRUNK_HINTS"; then
    warn=1
    cat >&2 <<EOF
[git-hygiene] aviso (pre-push): push apontando para o TRONCO (${remote_ref}).

  Remote: ${remote:-?} ${url:-}
  Local:  ${local_ref:-?}

O que fazer:
  - Prefira branch feat|fix|chore/... e abra PR (/nova-branch + adapter scm).
  - Se for intencional (hotfix acordado), ok — este hook NÃO bloqueia no MVP.

Por quê: sem Edit policies, push no tronco não é barrado no servidor; o aviso
torna o desvio visível. Ver docs/cheatsheets/git-hygiene-cheatsheet.md (§1.3).

EOF
  fi
done

exit 0
