# Copie para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais.
# O .env é automaticamente ignorado pelo .gitignore.

# =============================================================
# ABAKO (placeholders; valores reais só no .env local)
# =============================================================
COMPOSE_PROJECT_NAME=abako           # nomes de contêiner/volume/rede
ABAKO_ENV=tst                        # tst | prd (padrão tst; prd só com confirmação)
ABAKO_PG_PORT=5433                   # nunca 5432 (outro projeto)
# Senha de ADMIN do banco: NÃO fica aqui. Fica num arquivo FORA do repositório
# (uma linha, só a senha); este caminho é lido pelo docker compose como secret.
ABAKO_ADMIN_PASSWORD_FILE=<CAMINHO_ABSOLUTO_DO_ARQUIVO_DA_SENHA_ADMIN>
# Donos dos bancos tst/prd (criados no primeiro `docker compose up`; não são admin)
ABAKO_OWNER_TST_PASSWORD=<SENHA_DONO_TST>
ABAKO_OWNER_PRD_PASSWORD=<SENHA_DONO_PRD>
# Migrações (Alembic). tst é o padrão; prd só com ABAKO_ENV=prd + ABAKO_CONFIRMA_PRD=sim
ABAKO_DB_MIGRATE_URL_TST=postgresql://abako_owner_tst:<SENHA_DONO_TST>@127.0.0.1:5433/tst
ABAKO_DB_MIGRATE_URL_PRD=postgresql://abako_owner_prd:<SENHA_DONO_PRD>@127.0.0.1:5433/prd
# Credenciais por papel (criadas nas migrações da task 03)
ABAKO_DB_APP_URL=postgresql://abako_app:<SENHA_APP>@127.0.0.1:5433/tst
ABAKO_DB_PIPELINE_URL=postgresql://abako_pipeline:<SENHA_PIPELINE>@127.0.0.1:5433/tst
ABAKO_DUCKDB_PATH=./data/analitico.duckdb

# =============================================================
# AMBIENTE
# =============================================================
ENVIRONMENT=local                    # local | dev | prd
PIPELINE_ENV=local                   # local | dev | prd (para pipelines de dados)

# =============================================================
# BANCO DE DADOS (Postgres)
# =============================================================
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DATABASE_URL_READONLY=postgresql://ro_user:password@localhost:5432/dbname

# =============================================================
# IA / LLM
# =============================================================
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-sonnet-4-6

# adversarial-judge (opcional — segunda opinião via OpenRouter no grill/PRD, skill
# .claude/skills/adversarial-judge/). Sem default embutido: escolha o modelo em
# openrouter.ai/models — o objetivo é diversidade de viés (fornecedor diferente do
# modelo principal), não um valor genérico.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_JUDGE_MODEL=fornecedor/nome-do-modelo

# Embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072

# =============================================================
# OBSERVABILIDADE
# =============================================================
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# =============================================================
# DATABRICKS (se pipeline cloud)
# =============================================================
DATABRICKS_HOST=https://adb-xxx.azuredatabricks.net
DATABRICKS_TOKEN=dapi...
DATABRICKS_CLUSTER_ID=0101-xxxxxxxx
DATABRICKS_CATALOG_DEV=dev_catalog
DATABRICKS_CATALOG_PRD=prd_catalog

# =============================================================
# AIRFLOW (se pipeline on-premises)
# =============================================================
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@localhost/airflow

# =============================================================
# OBJECT STORAGE
# =============================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=reports

# AWS S3 (alternativa ao MinIO)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# S3_BUCKET=your-bucket

# =============================================================
# NOTIFICAÇÕES (pipeline alerts)
# =============================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
PIPELINE_OWNER_EMAIL=data-team@company.com
